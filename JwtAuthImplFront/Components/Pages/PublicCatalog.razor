@page "/catalog"
@inject ProductsApiClient ProductsApi

<PageTitle>Catálogo público</PageTitle>

<h1>Catálogo público</h1>

<p>Esta página consume el endpoint <code>GET /api/products/public</code>, que es
<strong>anónimo</strong>: no requiere iniciar sesión y por eso <strong>no muestra el precio</strong>.</p>

@if (_loading)
{
    <p><em>Cargando...</em></p>
}
else if (_products is null)
{
    <div class="alert alert-warning">No se pudo obtener el catálogo (¿la API está en ejecución?).</div>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Producto</th><th>Descripción</th><th>Precio</th></tr>
        </thead>
        <tbody>
            @foreach (var product in _products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td><span class="badge text-bg-secondary">Requiere sesión</span></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<PublicProduct>? _products;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _products = await ProductsApi.GetPublicProductsAsync();
        }
        catch (HttpRequestException)
        {
            _products = null;
        }
        catch (TaskCanceledException)
        {
            _products = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
