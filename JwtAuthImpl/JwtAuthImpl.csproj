<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    La implementación cliente de JWT usa tipos de ASP.NET Core Components
    (AuthenticationStateProvider, ProtectedLocalStorage) y de la DI/HttpClient,
    por lo que se referencia el framework compartido en vez de paquetes sueltos.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
